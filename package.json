{
	"name": "lceda-bbox-exporter",
	"version": "1.0.0",
	"description": "嘉立创 EDA 专业版器件与图元 BBox 导出扩展",
	"author": "MeowKJ",
	"license": "Apache-2.0",
	"homepage": "https://github.com/MeowKJ/lceda-bbox-exporter",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "npm run compile && node --test tests/*.test.mjs",
		"test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
		"check": "npm run lint && npm run typecheck && npm run test && npm run test:python && npm run build",
		"build": "npm run compile && ts-node ./build/package.ts && node ./build/verify-package.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.3.4",
		"@types/fs-extra": "^11.0.4",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
